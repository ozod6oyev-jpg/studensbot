{
  "name": "daftar-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "bot": "bun bot/index.ts",
    "bot:info": "bun bot/index.ts info",
    "bot:webhook": "bun bot/index.ts webhook",
    "bot:poll": "bun bot/index.ts poll",
    "fonts:fetch": "bun scripts/fetch-fonts.ts",
    "check": "bun scripts/check-render.ts && bun scripts/check-pdf.ts && bun scripts/check-style.ts && bun scripts/check-bot.ts && bun scripts/check-font-sheet.ts && bun scripts/check-deploy.ts",
    "check:render": "bun scripts/check-render.ts",
    "check:pdf": "bun scripts/check-pdf.ts",
    "check:style": "bun scripts/check-style.ts",
    "check:bot": "bun scripts/check-bot.ts",
    "check:sheet": "bun scripts/check-font-sheet.ts",
    "check:deploy": "bun scripts/check-deploy.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.468.0",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
